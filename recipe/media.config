# The media options PR 117 of Linux-Kernel_MiSTer builds in, as modules,
# for a stock MiSTer kernel (merged into its own .config by build.sh).
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
# Only what UVC needs: no autoselected I2C tuners/sensors (and no I2C_MUX
# they would select), no camera sensor or lens drivers.
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
CONFIG_MEDIA_CAMERA_SUPPORT=y
# CONFIG_VIDEO_CAMERA_SENSOR is not set
# CONFIG_VIDEO_CAMERA_LENS is not set
CONFIG_VIDEO_DEV=m
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y
# DMA_SHARED_BUFFER cannot be a module and the stock kernel lacks it
# (patches/0001-media-videobuf2-build-without-dma-buf.patch).
CONFIG_VIDEOBUF2_NO_DMA_SHARED_BUFFER=y
